# Environment: Development
# Description: Environment variables for development environment
# Note: Do not commit sensitive information to version control
# LEARNING_PLATFORM_API_URL version to be used when REST API is running on port 5222, otherwise use the one for port 3000
# VITE_LEARNING_PLATFORM_API_URL="http://localhost:5222/api/v1"
VITE_LEARNING_PLATFORM_API_URL="http://localhost:3000/api/v1"

# Multi-endpoint platform URLs (Beeceptor mock instances)
VITE_CLINICAL_API_URL="https://prothia-api.free.beeceptor.com"
VITE_WORKSHOP_API_URL="https://prothiiaapi.free.beeceptor.com"
VITE_MONITORING_API_URL="https://prothia.free.beeceptor.com"
VITE_IAM_API_URL="https://prothiaapi.free.beeceptor.com"


VITE_PROTHIA_PLATFORM_API_URL="https://prothia-api.free.beeceptor.com"
VITE_PROTHIA_PLATFORM_API_URL_1="https://prothiiaapi.free.beeceptor.com"
VITE_PROTHIA_PLATFORM_API_URL_2="https://prothia.free.beeceptor.com"
VITE_PROTHIA_PLATFORM_API_URL_3="https://prothiaapi.free.beeceptor.com"

VITE_OPTIONS_ENDPOINT_PATH="/options"
VITE_PATIENTS_ENDPOINT_PATH="/patients"
VITE_EXERCISES_ENDPOINT_PATH="/exercises"
VITE_PRESCRIPTIONS_ENDPOINT_PATH="/prescriptions"
VITE_ALERTS_ENDPOINT_PATH="/alerts"
VITE_THRESHOLDS_ENDPOINT_PATH="/thresholds"
VITE_PROSTHESES_ENDPOINT_PATH="/prostheses"
VITE_MECHANICAL_ALERTS_ENDPOINT_PATH="/mechanicalAlerts"
VITE_MAINTENANCES_ENDPOINT_PATH="/maintenanceSchedules"
# VITE_SIGNUP_ENDPOINT_PATH is the path to the sign-up endpoint.
VITE_SIGNUP_ENDPOINT_PATH="/authentication/sign-up"
# VITE_SIGNIN_ENDPOINT_PATH is the path to the sign-in endpoint.
VITE_SIGNIN_ENDPOINT_PATH="/authentication/sign-in"
# VITE_USERS_ENDPOINT_PATH is the path to the users endpoint.
VITE_USERS_ENDPOINT_PATH="/users"
